---
import { LINKEDIN_URL, SITE_TITLE } from "../consts";

const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="/" aria-current={path === "/" ? "page" : undefined}>{SITE_TITLE}</a>
    <nav aria-label="Main navigation">
      <a href="/reflections/" aria-current={path.startsWith("/reflections") ? "location" : undefined}>Reflections</a>
      <a href="/about/" aria-current={path.startsWith("/about") ? "page" : undefined}>About</a>
      <a href={LINKEDIN_URL}>LinkedIn <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
