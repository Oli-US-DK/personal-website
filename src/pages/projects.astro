---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.order - a.data.order,
);
---

<BaseLayout title="Projects">
	<h1>Projects</h1>
	<ul class="entry-list">
		{
			projects.map((project) => (
				<li>
					{project.data.url ? (
						<a class="entry-title" href={project.data.url} target="_blank" rel="noopener noreferrer">
							{project.data.title}
						</a>
					) : (
						<span class="entry-title">{project.data.title}</span>
					)}
					<p class="entry-description">{project.data.description}</p>
				</li>
			))
		}
	</ul>
</BaseLayout>
