---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReflectionCard from "../components/ReflectionCard.astro";
import { getReflections } from "../reflections";

const [featured, ...recent] = await getReflections();
---
<BaseLayout>
  <div class="shell">
    <section class="hero">
      <div class="hero-title">
        <p class="label">Essays by Oliver Bjørner Søe</p>
        <h1>Reflections on AI,<br class="wide-break" /> business strategy,<br class="wide-break" /> and <em>building companies.</em></h1>
      </div>
      <div class="hero-aside">
        <p>I work with business leaders on putting AI into practice. Here, I write about what it takes to create value, how technology changes competition, and the decisions that follow.</p>
        <a class="text-link" href="/about/">About me <span aria-hidden="true">↗</span></a>
      </div>
    </section>
    {featured && (
      <section class="homepage-section" aria-labelledby="featured">
        <div class="section-heading">
          <h2 id="featured" class="label">Featured reflection</h2>
          <a class="text-link" href="/reflections/">All reflections <span aria-hidden="true">↗</span></a>
        </div>
        <ReflectionCard entry={featured} />
      </section>
    )}
    {recent.length > 0 && (
      <section class="homepage-section" aria-labelledby="recent">
        <div class="section-heading"><h2 id="recent" class="label">Recent reflections</h2></div>
        {recent.slice(0, 3).map((entry) => <ReflectionCard entry={entry} />)}
      </section>
    )}
  </div>
</BaseLayout>
